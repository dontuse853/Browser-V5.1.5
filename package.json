{
  "name": "dontuse-browser",
  "version": "1.0.0",
  "description": "A simple Chromium-based browser that searches your custom URL by default.",
  "main": "main.js",
  "author": "YOUR_NAME",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.dontusebrowser",
    "productName": "Dontuse Browser",
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "vpn.html"],
    "afterPack": "afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    }
  }
}
